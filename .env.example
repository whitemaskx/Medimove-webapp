# Copia este archivo a .env.local y rellena con tus credenciales.
# No subas `.env.local` al repositorio con credenciales reales.
# Opción A — URL completa (recomendada para Neon):
NEON_DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require

# Opción B — variables individuales (pg las detecta automáticamente):
PGHOST=<host>
PGDATABASE=<database>
PGUSER=<user>
PGPASSWORD=<password>
PGSSLMODE=require
PGCHANNELBINDING=require
